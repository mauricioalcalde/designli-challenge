{
  "name": "designli-challenge",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "prisma:generate": "pnpm --filter @designli-challenge/api prisma:generate",
    "prisma:migrate:deploy": "pnpm --filter @designli-challenge/api prisma:migrate:deploy",
    "setup": "pnpm install && pnpm prisma:generate && pnpm prisma:migrate:deploy",
    "dev:api": "pnpm --filter @designli-challenge/api start:dev",
    "dev:mobile": "pnpm --filter @designli-challenge/mobile start",
    "dev:mobile:android": "pnpm --filter @designli-challenge/mobile android",
    "dev:mobile:ios": "pnpm --filter @designli-challenge/mobile ios",
    "build:api": "pnpm --filter @designli-challenge/api build",
    "build:mobile:android": "pnpm --filter @designli-challenge/mobile exec expo run:android",
    "build:mobile:ios": "pnpm --filter @designli-challenge/mobile exec expo run:ios",
    "test": "pnpm test:api && pnpm test:mobile",
    "test:api": "pnpm --filter @designli-challenge/api test",
    "test:mobile": "pnpm --filter @designli-challenge/mobile test",
    "typecheck": "pnpm typecheck:api && pnpm typecheck:mobile",
    "typecheck:api": "pnpm --filter @designli-challenge/api typecheck",
    "typecheck:mobile": "pnpm --filter @designli-challenge/mobile exec tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx --ignore-pattern '**/node_modules/**' --ignore-pattern '**/dist/**' --ignore-pattern '**/.expo/**'",
    "format": "prettier --write \"**/*.{ts,tsx,json,yaml,md}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,yaml,md}\" --ignore-path .gitignore",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.4.0",
    "typescript": "^5.6.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yaml,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "expo-modules-core": "2.2.3"
  }
}
